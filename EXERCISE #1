<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Group 6 - Team</title>

    <style>

        /* =========================================
           GENERAL
        ========================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #ffffff;
            color: #111111;
            min-height: 100vh;
            padding: 25px 15px;
        }


        /* =========================================
           MAIN CONTAINER
        ========================================= */

        .team-container {
            width: 100%;
            max-width: 900px;
            margin: auto;

            background-color: #ffffff;

            padding: 30px 40px;

            position: relative;
            overflow: hidden;
        }


        /* =========================================
           DECORATIVE PINK STRIPES
        ========================================= */

        .team-container::before,
        .team-container::after {
            content: "";

            position: absolute;

            top: 48%;

            width: 45px;
            height: 90px;

            transform: translateY(-50%);

            background: repeating-linear-gradient(
                -45deg,
                #ff0055 0px,
                #ff0055 3px,
                transparent 3px,
                transparent 8px
            );

            z-index: 0;
        }

        .team-container::before {
            left: 0;
        }

        .team-container::after {
            right: 0;
        }


        /* =========================================
           HEADER
        ========================================= */

        .header {
            display: flex;
            align-items: center;

            margin-bottom: 40px;

            position: relative;
            z-index: 1;
        }

        .title-container {
            display: flex;
            align-items: center;

            width: 100%;
        }

        .title {
            font-size: clamp(1.7rem, 4vw, 2.5rem);

            font-weight: 900;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            white-space: nowrap;
        }

        .title .outline {
            color: transparent;

            -webkit-text-stroke: 1.5px #ff0055;
        }

        .title .filled {
            color: #ff0055;

            margin-left: 6px;
        }

        .header-line {
            height: 2px;

            background-color: #ff0055;

            flex: 1;

            margin-left: 18px;
        }


        /* =========================================
           TEAM GRID
        ========================================= */

        .team-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 32px 25px;

            position: relative;
            z-index: 1;
        }


        /* =========================================
           TEAM CARD
        ========================================= */

        .team-card {
            min-width: 0;
        }


        /* =========================================
           IMAGE
        ========================================= */

        .image-wrapper {
            width: 50%;

            aspect-ratio: 1 / 1;

            overflow: hidden;

            background-color: #f1f1f1;

            margin-bottom: 14px;

            position: relative;
        }

        .image-wrapper img {
            width: 100%;
            height: 100%;

            display: block;

            object-fit: cover;

            transition: transform 0.3s ease;
        }

        .image-wrapper:hover img {
            transform: scale(1.04);
        }


        /* =========================================
           MEMBER NAME
        ========================================= */

        .member-name {
            color: #ff0055;

            font-size: 0.9rem;

            font-weight: 900;

            text-transform: uppercase;

            letter-spacing: 0.7px;

            margin-bottom: 7px;
        }


        /* =========================================
           MEMBER INFORMATION
        ========================================= */

        .member-desc {
            color: #333333;

            font-size: 0.75rem;

            line-height: 1.6;

            font-weight: 400;
        }

        .member-desc p {
            margin: 0;
        }

        .member-desc strong {
            color: #ff0055;

            font-weight: 800;
        }


        /* =========================================
           MEMBER 7 CENTER
        ========================================= */

        .member-seven {
            grid-column: 2;
        }


        /* =========================================
           TABLET
        ========================================= */

        @media (max-width: 900px) {

            .team-container {
                max-width: 750px;

                padding: 25px 30px;
            }

            .team-grid {
                grid-template-columns: repeat(2, 1fr);

                gap: 28px 22px;
            }

            .member-seven {
                grid-column: auto;
            }

            .team-container::before,
            .team-container::after {
                display: none;
            }
        }


        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 600px) {

            body {
                padding: 15px 8px;
            }

            .team-container {
                padding: 20px;
            }

            .header {
                margin-bottom: 30px;
            }

            .title {
                font-size: 1.6rem;
            }

            .header-line {
                display: none;
            }

            .team-grid {
                grid-template-columns: 1fr;

                gap: 35px;
            }

            .member-seven {
                grid-column: auto;
            }

            .member-name {
                font-size: 0.95rem;
            }

            .member-desc {
                font-size: 0.8rem;
            }
        }

    </style>

</head>


